# Gemini API Key for Visual Search
GEMINI_API_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# SMTP Email Configuration for Registration Verification
# For Gmail: Use 'smtp.gmail.com', port 587, and an 'App Password' (NOT your regular password).
# How to get an App Password: https://support.google.com/accounts/answer/185833
# Example App Password Format: iend wlqp zpxz lzay (Enter without spaces: iendwlqpzpxzlzay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bexobd@gmail.com
SMTP_PASS=
SMTP_FROM=bexobd@gmail.com

# SMS Gateway Configuration for Registration Verification
# Supported values for SMS_PROVIDER: 'greenweb', 'bulksmsbd', 'demo'
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=



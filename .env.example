VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side variables (used in Express backend / Serverless endpoints)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

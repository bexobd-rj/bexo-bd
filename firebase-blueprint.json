{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Products available for dropshipping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "basePrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "stockStatus": { "type": "string", "enum": ["in_stock", "out_of_stock"] },
        "stock": { "type": "number" }
      },
      "required": ["title", "basePrice"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders placed by resellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "deliveryZone": { "type": "string", "enum": ["inside", "outside"] },
        "deliveryCharge": { "type": "number" },
        "basePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "profit": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processing", "Shipped", "Delivered", "Returned"] },
        "trackingLink": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "userId": { "type": "string" },
        "resellerName": { "type": "string" },
        "resellerShopName": { "type": "string" },
        "resellerEmail": { "type": "string" },
        "profitStatus": { "type": "string", "enum": ["not_added", "pending_approval", "completed"] }
      },
      "required": ["customerName", "customerPhone", "customerAddress", "sellingPrice", "userId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and balance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "balance": { "type": "number" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "shopName": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transactions (income/withdrawals)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "withdrawal"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "referenceId": { "type": "string" }
      },
      "required": ["userId", "amount", "type", "description", "date"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Reseller orders"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User identity and balance"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transaction history (global)"
    }
  }
}
